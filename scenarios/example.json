{
  "name": "example-flat-walk",
  "description": "在默认测试点 (0.5, -63, 0.5) 朝向 0/0，直走 60 tick 并逐 tick 采样。",
  "setup": {
    "world": "flat",
    "time": 6000,
    "weather": "clear"
  },
  "steps": [
    { "type": "tp", "pos": [0.5, -63, 0.5] },
    { "type": "look", "yaw": 0, "pitch": 0 },
    { "type": "wait", "ticks": 5 },
    { "type": "input", "world": [0, 1], "ticks": 60 },
    { "type": "stop" }
  ],
  "sample": ["pos", "vel", "on_ground", "flags", "yaw", "pitch", "input"],
  "output": "example-flat-walk"
}
