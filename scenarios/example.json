{
  "name": "example-flat-walk",
  "description": "在测试平台中心 (0.5, -49, 0.5) 朝向 0/0，朝 +Z 直走 60 tick 并逐 tick 采样。先跑 scenarios/setup-platform.json 铺好平台。",
  "setup": {
    "strict": true,
    "verify": [
      { "pos": [0, -50, 0], "block": "minecraft:stone" }
    ]
  },
  "steps": [
    { "type": "tp", "pos": [0.5, -49, 0.5] },
    { "type": "look", "yaw": 0, "pitch": 0 },
    { "type": "wait", "ticks": 5 },
    { "type": "input", "world": [0, 1], "ticks": 60 },
    { "type": "stop" }
  ],
  "sample": ["pos", "vel", "on_ground", "flags", "yaw", "pitch", "input"],
  "output": "example-flat-walk"
}
