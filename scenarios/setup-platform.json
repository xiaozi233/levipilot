      { "pos": [32, -50, 32], "block": "minecraft:stone" },
      { "pos": [-32, -50, -32], "block": "minecraft:stone" },
      { "pos": [32, -50, -32], "block": "minecraft:stone" },
      { "pos": [0, -49, 0], "block": "air" },
      { "pos": [16, -49, 16], "block": "air" }
    ]
  },
  "steps": [
    { "type": "wait", "ticks": 5 }
