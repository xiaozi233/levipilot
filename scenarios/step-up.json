          -49,
          0
        ],
        "block": "air"
      },
      {
        "pos": [
          4,
          -49,
          0
        ],
        "block": "minecraft:stone"
      },
      {
        "pos": [
          4,
          -48,
          0
        ],
        "block": "air"
      }
    ],
    "teardown": [
      "fill 4 -49 -1 4 -49 1 air",
      "tp @s 0.5 -49 0.5 0 0"
