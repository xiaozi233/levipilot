{
  "name": "wall-stop",
  "description": "在空地上铺一条石质通道并在 x=6 处砌 3 格高的墙，玩家沿 +x 走 80 tick，测量撞墙后的停止位置与速度曲线。setup 用聊天命令搭建，跑完 teardown 清场。",
  "setup": {
    "strict": true,
    "commands": [
      "fill -3 -60 -1 9 -60 1 stone",
      "fill 6 -59 -1 6 -57 1 stone",
      "tp @s 0.5 -59 0.5"
    ],
    "verify": [
      { "pos": [0, -60, 0], "block": "minecraft:stone" },
      { "pos": [3, -59, 0], "block": "air" },
      { "pos": [6, -59, 0], "block": "minecraft:stone" }
    ],
    "teardown": [
      "fill -3 -60 -1 9 -57 1 air"
    ]
  },
  "steps": [
    { "type": "tp", "pos": [0.5, -59, 0.5], "settle_ticks": 5 },
    { "type": "look", "yaw": 0, "pitch": 0, "settle_ticks": 2 },
    { "type": "wait", "ticks": 5 },
    { "type": "input", "world": [1, 0], "ticks": 80 },
    { "type": "stop" }
  ],
  "sample": ["pos", "vel", "on_ground", "yaw", "pitch", "input"],
  "output": "wall-stop"
}
