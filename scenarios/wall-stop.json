{
  "name": "wall-stop",
  "description": "在测试平台上 x=6 处砌一道 3 格高的墙，玩家从平台中心朝 +X 走 80 tick，测量撞墙停止位置。需要先跑 scenarios/setup-platform.json。",
  "setup": {
    "strict": true,
    "commands": [
      "fill 6 -49 -1 6 -47 1 stone"
    ],
    "verify": [
      { "pos": [0, -50, 0], "block": "minecraft:stone" },
      { "pos": [3, -49, 0], "block": "air" },
      { "pos": [6, -49, 0], "block": "minecraft:stone" }
    ],
    "teardown": [
      "fill 6 -49 -1 6 -47 1 air",
      "tp @s 0.5 -49 0.5 0 0"
    ]
  },
  "steps": [
    { "type": "tp", "pos": [0.5, -49, 0.5], "settle_ticks": 5 },
    { "type": "look", "yaw": 0, "pitch": 0, "settle_ticks": 2 },
    { "type": "wait", "ticks": 5 },
    { "type": "input", "world": [1, 0], "ticks": 80 },
    { "type": "stop" }
  ],
  "sample": ["pos", "vel", "on_ground", "yaw", "pitch", "input"],
  "output": "wall-stop"
}
